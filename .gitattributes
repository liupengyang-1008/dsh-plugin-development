# Default: normalise line endings in the repository
* text=auto

# Shell scripts MUST stay LF, or they fail with "bad interpreter" on Linux/macOS
*.sh text eol=lf

# Python scripts likewise
*.py text eol=lf

# Markdown / YAML / TS / JS / JSON are reviewed as text
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf

# Extensionless text files: `* text=auto` alone would check them out as CRLF on
# Windows (LICENSE has no extension), which then leaks into the packaged zip.
LICENSE text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# NOTICE has no extension either. It carries verbatim upstream attribution text,
# so a CRLF rewrite would alter bytes we are required to reproduce unchanged.
NOTICE text eol=lf

# Bundled license texts — same reason as NOTICE.
licenses/*.txt text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.zip binary
